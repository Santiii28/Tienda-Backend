# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a Git.

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=cambia-esto

# True solo en tu computador. En producción: False (o no definirla).
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Cadena de conexión de Neon (PostgreSQL).
DATABASE_URL=postgresql://usuario:clave@host/basedatos?sslmode=require

# Solo en producción: dominio del frontend en Vercel (sin barra final).
# FRONTEND_ORIGINS=https://mi-tienda.vercel.app
